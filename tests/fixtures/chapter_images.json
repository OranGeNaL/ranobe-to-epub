t":[{"type":"text","text":"\u2014 \u0416\u0430\u0440\u043a\u043e, \u0436\u0430\u0440\u043a\u043e, \u0436\u0430\u0440\u043a\u043e, \u0436\u0430\u0440\u043a\u043e\u2026 "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u043b \u0440\u043e\u0442, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043a\u0440\u0438\u0447\u0430\u0442\u044c, \u0432\u043c\u0435\u0441\u0442\u043e \u043a\u0440\u0438\u043a\u0430 \u0432\u044b\u0440\u0432\u0430\u043b\u0441\u044f \u043a\u043e\u043c\u043e\u043a \u043a\u0440\u043e\u0432\u0438. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041a\u0430\u0448\u043b\u044f\u044f, \u043e\u043d \u0441\u043f\u043b\u044e\u043d\u0443\u043b \u043c\u043d\u043e\u0433\u043e \u043a\u0440\u043e\u0432\u0438. \u041f\u0435\u043d\u0438\u0441\u0442\u0430\u044f \u043a\u0440\u043e\u0432\u044c \u0441\u0442\u0430\u043b\u0430 \u0441\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u0443\u0433\u043e\u043b\u043a\u0430\u0445 \u0440\u0442\u0430, \u043f\u043e\u043a\u0430 \u043e\u043d \u0445\u0440\u0438\u043f\u0435\u043b. \u0415\u0433\u043e \u0442\u0443\u0441\u043a\u043b\u044b\u0435 \u0433\u043b\u0430\u0437\u0430 \u0432\u0438\u0434\u0435\u043b\u0438, \u0437\u0435\u043c\u043b\u044f \u0431\u044b\u043b\u0430 \u043a\u0440\u0430\u0441\u043d\u043e\u0439. "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2014 \u042d\u0442\u043e\u2026 \u0432\u0441\u0451 \u043c\u043e\u044f \u043a\u0440\u043e\u0432\u044c? "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041a\u0440\u043e\u0432\u0438 \u0431\u044b\u043b\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u043f\u0438\u0442\u0430\u0442\u044c \u0435\u0433\u043e \u0443\u043f\u0430\u0432\u0448\u0435\u0435 \u0442\u0435\u043b\u043e. \u041a\u0440\u043e\u0432\u044c \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u043a\u043e\u043b\u043e 8% \u043c\u0430\u0441\u0441\u044b \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0442\u0435\u043b\u0430, \u0438 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043f\u043e\u0442\u0435\u0440\u044f \u0442\u0440\u0435\u0442\u0438 \u044d\u0442\u043e\u0433\u043e \u043e\u0431\u044a\u0451\u043c\u0430 \u043e\u043f\u0430\u0441\u043d\u0430 \u0434\u043b\u044f \u0436\u0438\u0437\u043d\u0438, \u043d\u043e\u2026 \u041a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u043e\u043d \u0443\u0436\u0435 \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u044e. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041a\u0440\u043e\u0432\u044c \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0430 \u0438\u0434\u0442\u0438 \u0438\u0437\u043e \u0440\u0442\u0430, \u043d\u043e \u00ab\u0436\u0430\u0440\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u0443\u0434\u0442\u043e \u0431\u044b \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0441\u044f \u0438\u0441\u043f\u0435\u043f\u0435\u043b\u0438\u0442\u044c \u0435\u0433\u043e, \u0432\u0441\u0451 \u0435\u0449\u0451 \u043d\u0435 \u0443\u0442\u0438\u0445\u0430\u043b. \u041e\u043d \u0441 \u0442\u0440\u0443\u0434\u043e\u043c \u043f\u043e\u0442\u044f\u043d\u0443\u043b\u0441\u044f \u0440\u0443\u043a\u043e\u0439 \u043a \u0436\u0438\u0432\u043e\u0442\u0443 \u0438, \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0432 \u0442\u0430\u043c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435, \u0432\u0441\u0451 \u043f\u043e\u043d\u044f\u043b. "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2014 \u041c\u043d\u0435 \u0432\u0441\u043f\u043e\u0440\u043e\u043b\u0438 \u0436\u0438\u0432\u043e\u0442, \u0434\u0430? "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041d\u0435\u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0447\u0442\u043e \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u0442\u0430\u043a \u0436\u0430\u0440\u043a\u043e. \u041a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0435\u0433\u043e \u043c\u043e\u0437\u0433 \u0441\u043f\u0443\u0442\u0430\u043b \u00ab\u0431\u043e\u043b\u044c\u00bb \u0441 \u00ab\u0436\u0430\u0440\u043e\u043c\u00bb. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0415\u0433\u043e \u043f\u043e\u0447\u0442\u0438 \u0440\u0430\u0437\u043e\u0440\u0432\u0430\u043b\u0438 \u043f\u043e\u043f\u043e\u043b\u0430\u043c, \u043b\u0438\u0448\u044c \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u043a\u043e\u0436\u0438 \u043d\u0430 \u0441\u043f\u0438\u043d\u0435 \u0441\u043a\u0440\u0435\u043f\u043b\u044f\u043b\u043e \u0435\u0433\u043e \u0442\u0435\u043b\u043e. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0418\u043d\u044b\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438, \u044d\u0442\u043e \u0431\u044b\u043b \u00ab\u0448\u0430\u0445 \u0438 \u043c\u0430\u0442\u00bb \u0434\u043b\u044f \u043d\u0435\u0433\u043e. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0412 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043e\u0441\u043e\u0437\u043d\u0430\u043b \u044d\u0442\u043e, \u0435\u0433\u043e \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0443\u0433\u0430\u0441\u0430\u0442\u044c. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0414\u0430\u0436\u0435 \u0436\u0430\u0440, \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0432\u0448\u0438\u0439 \u043a\u043e\u0440\u0447\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0431\u043e\u043b\u0438, \u0438\u0441\u0447\u0435\u0437. \u0414\u0430\u0436\u0435 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u0438 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0442\u0440\u043e\u0433\u0430\u043b \u0441\u0432\u043e\u0438 \u043e\u0440\u0433\u0430\u043d\u044b, \u0432\u0441\u0451 \u044d\u0442\u043e \u0443\u0433\u0430\u0441\u0430\u043b\u043e \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435\u043c. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0412\u0441\u0451, \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c, \u2014 \u044d\u0442\u043e \u0442\u0435\u043b\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0442\u044c \u0435\u0433\u043e \u0434\u0443\u0448\u0443. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u042d\u0442\u043e \u0442\u0435\u043b\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u043e \u043e\u0441\u0442\u0430\u0442\u043a\u0438 \u0443\u0433\u0430\u0441\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u043f\u043e\u0448\u0435\u0432\u0435\u043b\u0438\u0442\u044c\u0441\u044f. \u041e\u043d\u043e \u043f\u043e\u0434\u043d\u044f\u043b\u043e \u0433\u043e\u043b\u043e\u0432\u0443. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0427\u0451\u0440\u043d\u044b\u0435 \u0442\u0443\u0444\u043b\u0438 \u0432\u044b\u0437\u0432\u0430\u043b\u0438 \u0432\u043e\u043b\u043d\u044b \u0432 \u043b\u0443\u0436\u0435 \u043a\u0440\u043e\u0432\u0438 \u043f\u0435\u0440\u0435\u0434 \u0435\u0433\u043e \u0433\u043b\u0430\u0437\u0430\u043c\u0438. \u0422\u0430\u043c \u0431\u044b\u043b \u043a\u0442\u043e-\u0442\u043e. \u0418 \u044d\u0442\u043e\u0442 \u043a\u0442\u043e-\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0431\u044b\u043b \u0435\u0433\u043e \u0443\u0431\u0438\u0439\u0446\u0435\u0439. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0421\u0442\u0440\u0430\u043d\u043d\u043e, \u043d\u043e \u0435\u043c\u0443 \u043d\u0435 \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0432\u0438\u0434\u0435\u0442\u044c \u0435\u0451 \u043b\u0438\u0446\u0430. \u042d\u0442\u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043e\u0442\u043d\u044f\u043b \u0443 \u043d\u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c, \u0438 \u0432\u0441\u0451 \u0436\u0435 \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0437\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043a\u043e\u043d\u0446\u043e\u043c. \u0423 \u043d\u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u043a\u0442\u043e \u044d\u0442\u043e \u0431\u044b\u043b, \u043d\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u044d\u0442\u043e \u043d\u0435 \u0432\u0430\u0436\u043d\u043e. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041e\u043d \u043b\u0438\u0448\u044c \u0436\u0435\u043b\u0430\u043b, \u0447\u0442\u043e\u0431\u044b \u0434\u0435\u0432\u0443\u0448\u043a\u0430 \u0431\u044b\u043b\u0430 \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2014 \u2026\u0411\u0430\u0440\u0443? "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0415\u043c\u0443 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u0433\u043e\u043b\u043e\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0443\u0441\u043b\u044b\u0448\u0430\u043b, \u0431\u044b\u043b \u0441\u043b\u043e\u0432\u043d\u043e \u0437\u0432\u043e\u043d \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u044c\u0447\u0438\u043a\u043e\u0432. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041e\u043d \u0443\u0436\u0435 \u0431\u044b\u043b \u0437\u0430 \u0433\u0440\u0430\u043d\u044c\u044e, \u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430, \u0442\u0430\u043a \u0447\u0442\u043e, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043b\u0438\u0448\u044c \u0435\u0433\u043e \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435."}]},{"type":"paragraph","content":[{"type":"text","text":" \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u043e, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u0440\u0435\u0430\u043b\u044c\u043d\u043e, \u043e\u043d \u043d\u0430\u0448\u0451\u043b \u0432 \u043d\u0451\u043c \u0443\u0442\u0435\u0448\u0435\u043d\u0438\u0435. "}]},{"type":"paragraph","content":[{"type":"text","text":"\u0418 \u043f\u043e\u044d\u0442\u043e\u043c\u0443\u2015 "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2014 \u2015! "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043a\u0440\u0438\u043a, \u0438 \u043a\u0440\u043e\u0432\u0430\u0432\u044b\u0439 \u043a\u043e\u0432\u0451\u0440 \u043f\u0440\u0438\u043d\u044f\u043b \u0435\u0449\u0451 \u043e\u0434\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041e\u043d\u0430 \u0443\u043f\u0430\u043b\u0430 \u043f\u0440\u044f\u043c\u043e \u0440\u044f\u0434\u043e\u043c \u0441 \u043d\u0438\u043c, \u0442\u043e\u0447\u043d\u043e \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0440\u0443\u043a\u0430. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u0415\u0451 \u0431\u043b\u0435\u0434\u043d\u0430\u044f \u0440\u0443\u043a\u0430 \u0431\u0435\u0441\u0441\u0438\u043b\u044c\u043d\u043e \u0443\u043f\u0430\u043b\u0430, \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0430\u044f\u0441\u044c \u0441 \u0435\u0433\u043e. "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2014 \u041d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0435. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041e\u043d \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b, \u043a\u0430\u043a \u0435\u0451 \u043f\u0430\u043b\u044c\u0446\u044b \u0441\u043b\u0435\u0433\u043a\u0430 \u0434\u0432\u0438\u043d\u0443\u043b\u0438\u0441\u044c, \u0431\u0443\u0434\u0442\u043e \u0441\u0436\u0438\u043c\u0430\u044f \u0435\u0433\u043e \u0440\u0443\u043a\u0443. "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2014 \u2026\u0436\u0434\u0438. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041e\u043d \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0432\u043e\u0451 \u0443\u0433\u0430\u0441\u0430\u044e\u0449\u0435\u0435 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043d\u0430 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u0438\u0435. \u0411\u043e\u043b\u044c \u0438 \u0436\u0430\u0440, \u0432\u0441\u0451 \u0438\u0441\u0447\u0435\u0437\u043b\u043e. \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0431\u0435\u0441\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e\u0435 \u0443\u0441\u0438\u043b\u0438\u0435, \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0440\u0430\u0442\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u0432\u0448\u0438\u043c. "}]},{"type":"paragraph","content":[{"type":"text","text":" \u041d\u043e \u0434\u0430\u0436\u0435 \u0442\u0430\u043a\u2015 "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2014 \u042f \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u2026 "}]},{"type":"paragraph","content":[{"type":"text","text":"\u2015 \u0421\u043f\u0430\u0441\u0443 \u0442\u0435\u0431\u044f. "}]},{"type":"paragraph","content":[{"type":"text","text":"\u0412 \u044d\u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0436\u0438\u0437\u043d\u044c \u041d\u0430\u0446\u0443\u043a\u0438 \u0421\u0443\u0431\u0430\u0440\u0443 \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0430\u0441\u044c."}]},{"type":"image","attrs":{"description":null,"images":[{"image":"6e1c2c43-8162-41f6-be49-932258982643"}]}}]},"attachments":[{"filename":"6e1c2c43-8162-41f6-be49-932258982643.png","name":"6e1c2c43-8162-41f6-be49-932258982643","extension":"png","width":1852,"height":2800,"url":"\/uploads\/ranobe\/94231\/chapters\/3422985\/6e1c2c43-8162-41f6-be49-932258982643.png","previewUrl":"\/uploads\/ranobe\/94231\/chapters\/3422985\/6e1c2c43-8162-41f6-be49-932258982643.png","originalUrl":"\/uploads\/ranobe\/94231\/chapters\/3422985\/6e1c2c43-8162-41f6-be49-932258982643.png"},{"filename":"8ef3d556-d13b-4709-90bb-6520828aafb5.png","name":"8ef3d556-d13b-4709-90bb-6520828aafb5","extension":"png","width":2210,"height":1582,"url":"\/uploads\/ranobe\/94231\/chapters\/3422985\/8ef3d556-d13b-4709-90bb-6520828aafb5.png","previewUrl":"\/uploads\/ranobe\/94231\/chapters\/3422985\/8ef3d556-d13b-4709-90bb-6520828aafb5.png","originalUrl":"\/uploads\/ranobe\/94231\/chapters\/3422985\/8ef3d556-d13b-4709-90bb-6520828aafb5.png"},{"filename":"fcb2c86f-2036-445e-a692-576737e65287.png","name":"fcb2c86f-2036-445e-a692-576737e65287","extension":"png","width":1432,"height":2048,"url":"\/uploads\/ranobe\/94231\/chapters\/3422985\/fcb2c86f-2036-445e-a692-576737e65287.png","previewUrl":"\/uploads\/ranobe\/94231\/chapters\/3422985\/fcb2c86f-2036-445e-a692-576737e65287.png","originalUrl":"\/uploads\/ranobe\/94231\/chapters\/3422985\/fcb2c86f-2036-445e-a692-576737e65287.png"},{"filename":"000005ce-38a3-42ac-bc66-7fc41a4680b3.png","name":"000005ce-38a3-42ac-bc66-7fc41a4680b3","extension":"png","width":1432,"height":2048,"url":"\/uploads\/ranobe\/94231\/chapters\/3422985\/000005ce-38a3-